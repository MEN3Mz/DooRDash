{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Main",
      "request": "launch",
      "mainClass": "game.controllers.Main",
      "projectName": "DoorDash"
    },
    {
      "type": "java",
      "name": "Run DoorDash Board",
      "request": "launch",
      "preLaunchTask": "Build DoorDash",
      "mainClass": "game.view.Main",
      "classPaths": ["${workspaceFolder}\\out", "${workspaceFolder}\\src"],
      "vmArgs": "--module-path \"${workspaceFolder}\\lib\\javafx-sdk-21.0.11\\lib\" --add-modules javafx.controls,javafx.fxml,javafx.graphics"
    }
  ]
}
